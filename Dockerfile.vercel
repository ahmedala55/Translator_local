FROM node:24-bookworm-slim AS web-build
WORKDIR /build
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web/ ./
ENV NEXT_TELEMETRY_DISABLED=1
RUN npm run build

FROM python:3.12-slim-bookworm
COPY --from=web-build /usr/local/bin/node /usr/local/bin/node
WORKDIR /app
RUN pip install --no-cache-dir 'argostranslate @ https://github.com/argosopentech/argos-translate/archive/17ed1a9b055c5ba1b51d76b683bbb0c64e2a4a88.zip'
COPY engine.py setup_models.py translation_worker.py ./
RUN python setup_models.py
COPY --from=web-build /build/.next/standalone/ ./web/
COPY --from=web-build /build/.next/static/ ./web/.next/static/
ENV NODE_ENV=production HOSTNAME=0.0.0.0 PORT=8000
ENV ARGOS_PYTHON=/usr/local/bin/python ARGOS_LOCAL_ENGINE=1
EXPOSE 8000
WORKDIR /app/web
CMD ["node", "server.js"]
